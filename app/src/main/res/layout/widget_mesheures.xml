<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/icon_512" android:contentDescription="MesHeures"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="7dp" android:text="MesHeures" android:textColor="@color/widget_text_primary" android:textSize="13sp" android:textStyle="bold"/>
  <ImageView android:id="@+id/widget_add" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/widget_add_bg" android:contentDescription="Ajouter une journée"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="4dp">
  <TextView android:id="@+id/widget_tte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="—" android:textColor="@color/widget_text_primary" android:textSize="24sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_net" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/widget_ok" android:textSize="16sp" android:textStyle="bold"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_tte_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TTE aujourd'hui" android:textColor="@color/widget_text_muted" android:textSize="9sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
  <TextView android:id="@+id/widget_week" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Semaine —" android:textColor="@color/widget_text_secondary" android:textSize="10sp"/>
  <TextView android:id="@+id/widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14 j —" android:textColor="@color/widget_text_secondary" android:textSize="10sp"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
  <ImageView android:id="@+id/widget_dot" android:layout_width="9dp" android:layout_height="9dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_dot"/>
  <TextView android:id="@+id/widget_marge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ouvre l'app pour synchroniser" android:textColor="@color/widget_text_secondary" android:textSize="10sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="" android:textColor="@color/widget_text_muted" android:textSize="8sp"/>
</LinearLayout>
